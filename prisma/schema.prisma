generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Peserta {
  id          Int      @id @default(autoincrement())
  noRegistrasi String  @unique
  nama        String
  email       String   @unique
  whatsapp    String
  institusi   String
  programStudi String
  jabatan     String
  kehadiran   String
  createdAt   DateTime @default(now())
}

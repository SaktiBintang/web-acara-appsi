generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Peserta {
  id              Int      @id @default(autoincrement())
  noRegistrasi    String   @unique
  email           String   @unique
  namaLengkap     String
  whatsapp        String
  jabatan         String
  perguruanTinggi String
  provinsi        String
  fakultas        String
  programStudi    String
  pertanyaan      String?
  konfirmasiHadir Boolean
  createdAt       DateTime @default(now())
}
